# RestaurantOS on-premise deployment settings.
# Copy this file to .env before running docker compose.

# Public URL used by the browser for Socket.IO and uploaded images.
# For same-machine testing:
APP_PUBLIC_URL=http://localhost:8080
# For LAN access, use the server IP or DNS name, for example:
# APP_PUBLIC_URL=http://192.168.1.50:8080

# Host port exposed by Docker.
APP_PORT=8080

# PostgreSQL settings used inside Docker.
POSTGRES_DB=restaurantos
POSTGRES_USER=restaurantos
POSTGRES_PASSWORD=change_this_database_password

# Application DB connection. Keep DB_HOST=db for the bundled PostgreSQL service.
DB_HOST=db
DB_PORT=5432
DB_NAME=restaurantos
DB_USER=restaurantos
DB_PASSWORD=change_this_database_password

# Security secrets. Replace these before production use.
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret_min_32_chars

# Local/offline device identity.
DEVICE_ID=ONPREM-POS-01
BRANCH_CODE=MAIN
DEVICE_LABEL=RestaurantOS On-Prem Server

# First-time install data. Set false if restoring a real database backup.
RUN_SEED_DATA=true

# Optional cloud sync. Leave blank for fully offline on-premise mode.
# CLOUD_API_URL=https://restaurantos-production-bdb7.up.railway.app
# CLOUD_SYNC_TOKEN=
SYNC_WORKER_INTERVAL_MS=15000
MASTER_SYNC_PULL_INTERVAL_MS=60000

# Upload and offline menu image cache.
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
OFFLINE_IMAGE_CACHE_LIMIT=500
OFFLINE_IMAGE_FETCH_TIMEOUT_MS=15000

# Optional Cloudinary config for deployments that upload menu images to Cloudinary.
# CLOUDINARY_URL=
CLOUDINARY_FOLDER=restaurantos
